# ==============================================================================
# TRADEGRID Production Environment Configuration Template
# Copy to .env.production and configure before starting production deployment.
# ==============================================================================

# Node Runtime Environment
NODE_ENV=production
PORT=5000
FRONTEND_PORT=80

# Database Configuration (MySQL 8.0)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tradegrid
DB_USER=tradegrid_user
# IMPORTANT: Generate a strong alphanumeric password for production!
DB_PASSWORD=replace_with_secure_production_db_password
DB_ROOT_PASSWORD=replace_with_secure_production_root_password
DB_POOL_MIN=5
DB_POOL_MAX=25
DB_ACQUIRE_TIMEOUT_MS=10000

# JSON Web Token (JWT) Security Secrets
# IMPORTANT: Generate distinct 64-character random hexadecimal secrets for access & refresh!
JWT_ACCESS_SECRET=replace_with_64_character_hexadecimal_random_access_secret_key
JWT_REFRESH_SECRET=replace_with_64_character_hexadecimal_random_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Policy & Allowed Origins
CORS_ORIGIN=http://localhost

# Market Data Feed Configuration
# Default: SIMULATED_PROVIDER ($0 operating cost, deterministic simulated feeds)
MARKET_DATA_PRIMARY_PROVIDER=SIMULATED_PROVIDER

# Optional: Licensed Indian Equity Feeds (NSE/BSE)
# Leave empty / commented for default $0 zero-cost operation.
# NSE_FEED_API_KEY=
# NSE_FEED_SECRET=
# NSE_LICENSE_ID=

# Rate Limiting & Denial of Service Protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging & Monitoring
LOG_LEVEL=info
