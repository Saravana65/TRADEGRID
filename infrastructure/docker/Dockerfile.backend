# ==============================================================================
# TRADEGRID Backend Dockerfile (Hardened Multi-Stage Production Build)
# ==============================================================================

# Stage 1: Build stage
FROM node:24-alpine AS builder

WORKDIR /app

# Install native build tools for compiling argon2
RUN apk add --no-cache python3 make g++

# Copy package manifests
COPY package.json package-lock.json* ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/validation/package.json ./packages/validation/
COPY apps/backend/package.json ./apps/backend/

# Install dependencies (clean install)
RUN npm ci

# Copy source code and tsconfigs
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/backend ./apps/backend
COPY database ./database

# Compile TypeScript
RUN npm run build:packages
RUN npm run build:backend

# Stage 2: Production runtime stage
FROM node:24-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Security hardening: Create non-root user and group
RUN addgroup -S tradegrid && adduser -S tradegrid -G tradegrid

# Copy node_modules and built artifacts with non-root ownership
COPY --from=builder --chown=tradegrid:tradegrid /app/node_modules ./node_modules
COPY --from=builder --chown=tradegrid:tradegrid /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder --chown=tradegrid:tradegrid /app/packages/shared-types/package.json ./packages/shared-types/package.json
COPY --from=builder --chown=tradegrid:tradegrid /app/packages/validation/dist ./packages/validation/dist
COPY --from=builder --chown=tradegrid:tradegrid /app/packages/validation/package.json ./packages/validation/package.json
COPY --from=builder --chown=tradegrid:tradegrid /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder --chown=tradegrid:tradegrid /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=builder --chown=tradegrid:tradegrid /app/database ./database

# Switch to unprivileged non-root user
USER tradegrid

EXPOSE 5000

# Built-in lightweight healthcheck using Node http module
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 5000) + '/api/v1/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1

CMD ["node", "apps/backend/dist/server.js"]
