# ==============================================================================
# TRADEGRID Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file with secrets into version control!
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5005

# Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5005/api/v1
VITE_WS_URL=http://localhost:5005

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tradegrid
DB_USER=tradegrid_user
DB_PASSWORD=tradegrid_secure_password
DB_ROOT_PASSWORD=tradegrid_root_password
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=tradegrid_dev_access_secret_key_minimum_32_characters_long_12345
JWT_REFRESH_SECRET=tradegrid_dev_refresh_secret_key_minimum_32_characters_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 Hashing Parameters (Defaults are calibrated for security & performance)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Phase 2: Virtual Wallet & Ledger Configuration
INITIAL_WALLET_BALANCE=100000.0000
DEFAULT_CURRENCY=USD
